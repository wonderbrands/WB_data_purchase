<odoo>
    <data>
        <record id="purchase_order_form_inherit_clean" model="ir.ui.view">
            <field name="name">purchase_order_inherit_clean</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="attributes">
                    <attribute name ="domain">[('data_wb_supplier', '=', True)]</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>